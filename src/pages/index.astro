---
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SHOP_ENABLED } from '../config';
import sunflower from '../assets/sunflower.jpg';
import csvFile from '../data/mariewatson3371.csv?raw';

// ── Galleries: same nine categories, same wording ─────────────────
const galleries = [
  { title: 'Animals', folder: 'Animals', desc: 'Animal illustrations full of character.' },
  { title: 'Daily Prompts', folder: 'Misc', desc: 'A selection of work created through daily prompts and creative exercises.' },
  { title: 'Birds', folder: 'Birds', desc: 'Inspired by Birds.' },
  { title: 'Food', folder: 'Food', desc: 'Delicious digital treats.' },
  { title: 'Nature Echoes', folder: 'NatureEchoes', desc: 'Atmospheric nature‑themed artwork.' },
  { title: 'Plants', folder: 'Plants', desc: 'Greenery in bold artistic form.' },
  { title: 'Sunflowers', folder: 'Sunflowers', desc: 'Iconic sunflower studies.' },
  { title: 'Winter Olympics 2026', folder: 'WinterOlympics2026', desc: 'My highlights of the Winter Olympics.' },
  { title: 'Christmas', folder: 'Christmas', desc: 'Festive seasonal illustrations.' },
];

// Discover every artwork at build time — no manifests, no probing
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galleries/**/*.{jpg,jpeg,png,webp,gif}',
  { eager: true }
);

const byFolder: Record<string, { name: string; img: ImageMetadata }[]> = {};
for (const [path, mod] of Object.entries(modules)) {
  const m = path.match(/galleries\/([^/]+)\/([^/]+)$/);
  if (!m) continue;
  (byFolder[m[1]] ??= []).push({ name: m[2], img: mod.default });
}
for (const list of Object.values(byFolder)) {
  list.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));
}

// Optimized variants: card covers + full-size lightbox images
const galleryCards = await Promise.all(
  galleries.map(async (g) => {
    const files = byFolder[g.folder] ?? [];
    const cover = files.length
      ? await getImage({ src: files[0].img, width: 900, format: 'webp', quality: 80 })
      : null;
    const fulls = await Promise.all(
      files.map((f) => getImage({ src: f.img, width: 1600, format: 'webp', quality: 82 }))
    );
    return { ...g, cover, count: files.length, fulls: fulls.map((f) => f.src) };
  })
);

const lightboxData = Object.fromEntries(galleryCards.map((g) => [g.folder, g.fulls]));

// ── Videos: parsed from the same CSV at build time ────────────────
const csvRaw = csvFile.replace(/^﻿/, '');
const videos = csvRaw
  .split(/\r?\n/)
  .slice(1)
  .map((line) => line.match(/^"(.*)","(.*)"$/))
  .filter((m): m is RegExpMatchArray => !!m)
  .map((m) => {
    const idMatch = m[2].match(/(?:v=|youtu\.be\/|embed\/)([a-zA-Z0-9_-]{11})/);
    return idMatch ? { title: m[1], id: idMatch[1] } : null;
  })
  .filter((v): v is { title: string; id: string } => !!v);
---

<Base title="Motha Maker - Art Gallery">
  <!-- Hero -->
  <section class="hero" id="home">
    <svg class="hero-sketch" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <!-- the artist's line: flourishes that draw themselves -->
      <path class="sketch-line sketch-a" pathLength="1" d="M 150 640
        C 220 560, 190 470, 250 400
        C 300 344, 370 350, 400 290
        C 424 242, 396 200, 356 216
        C 320 230, 330 284, 378 280
        M 262 392
        C 210 360, 150 380, 168 420
        C 182 452, 240 436, 262 392
        M 320 330
        C 368 356, 428 344, 424 306
        C 420 274, 362 282, 320 330" />
      <path class="sketch-line sketch-b" pathLength="1" d="M 1300 160
        C 1220 230, 1250 330, 1180 390
        C 1120 442, 1050 430, 1010 490
        C 978 538, 1010 584, 1052 566
        C 1090 550, 1076 496, 1028 504
        M 1168 400
        C 1220 438, 1284 424, 1276 384
        C 1268 350, 1206 358, 1168 400
        M 1110 456
        C 1062 428, 1000 442, 1006 480
        C 1012 514, 1072 504, 1110 456" />
    </svg>
    <canvas class="hero-canvas" id="heroCanvas" aria-hidden="true"></canvas>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="container">
      <h1>Digital art, made by a <em>human hand</em></h1>
      <p class="subtitle">No shortcuts. No generators. Just authentic, human-made art</p>
      <div class="hero-stage">
        <div class="hero-glow" aria-hidden="true">
          <Image src={sunflower} alt="" class="hero-glow-img" width={900} quality={82} format="webp" loading="eager" />
        </div>
        <div class="hero-frame gloss">
          <Image src={sunflower} alt="Sunflower artwork" class="hero-art" width={900} quality={82} format="webp" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Galleries -->
  <section class="gallery-section" id="gallery">
    <div class="container">
      <h2 class="section-heading">Galleries</h2>
      <div class="heading-rule"></div>
      <div class="gallery-grid">
        {galleryCards.map((g) => (
          <div class="gallery-category gloss reveal" data-folder={g.folder}>
            <div class="gallery-card">
              {g.cover && (
                <img
                  src={g.cover.src}
                  alt={`${g.title} gallery preview`}
                  class="gallery-image"
                  width={g.cover.attributes.width}
                  height={g.cover.attributes.height}
                  loading="lazy"
                />
              )}
            </div>
            <div class="gallery-meta">
              <h3>{g.title}</h3>
              <p class="gallery-description">{g.desc}</p>
              <span class="gallery-count">{g.count} pieces</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Shop (hidden via SHOP_ENABLED while the Shopify store is suspended) -->
  {SHOP_ENABLED && (
    <section class="shop-section" id="shop">
      <div class="container">
        <h2 class="section-heading">Shop</h2>
        <div class="heading-rule"></div>
        <p class="section-description">Original digital prints, available to own</p>
        <div class="shop-grid">
          <div class="shop-card gloss reveal"><div id="product-component-1771500370858"></div></div>
          <div class="shop-card gloss reveal"><div id="product-component-1771500230986"></div></div>
          <div class="shop-card gloss reveal"><div id="product-component-1771500327973"></div></div>
          <div class="shop-card gloss reveal"><div id="product-component-1771500303747"></div></div>
        </div>
      </div>
    </section>
  )}

  <!-- Videos -->
  <section class="videos-section" id="videos">
    <div class="container">
      <h2 class="section-heading">In Motion</h2>
      <div class="heading-rule"></div>
      <p class="section-description">Time-lapse of my work.</p>
      <div class="video-list" id="videoList">
        {videos.map((video, i) => (
          <div class="video-list-item reveal" data-video-id={video.id}>
            <div class="video-list-play">
              <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 5.14v13.72L19 12 8 5.14z" />
              </svg>
            </div>
            <span class="video-list-title">{video.title}</span>
            <span class="video-list-num">{String(i + 1).padStart(2, '0')}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox image data (built at compile time) -->
  <script type="application/json" id="gallery-data" set:html={JSON.stringify(lightboxData)} />

  <!-- Hero: your cursor is a stylus — calligraphic ink that fades like drying paint -->
  <script>
    const hero = document.querySelector<HTMLElement>('.hero');
    const canvas = document.getElementById('heroCanvas') as HTMLCanvasElement | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (hero && canvas && !reduceMotion) {
      const ctx = canvas.getContext('2d')!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let W = 0, H = 0;

      function resize() {
        W = hero!.offsetWidth;
        H = hero!.offsetHeight;
        canvas!.width = W * dpr;
        canvas!.height = H * dpr;
        canvas!.style.width = W + 'px';
        canvas!.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resize();
      window.addEventListener('resize', resize, { passive: true });

      // an ink point: position, calligraphic width, birth time
      type InkPoint = { x: number; y: number; w: number; t: number };
      type Stroke = InkPoint[];

      const strokes: Stroke[] = [];
      let stroke: Stroke | null = null;
      let lastX = 0, lastY = 0, lastT = 0, easedW = 0;

      const INK_LIFE = 6000;   // ms before a mark fully dries away
      const MAX_W = 16;        // slow, pressed line
      const MIN_W = 2;         // fast flick

      // eased cursor for the gloss light
      let mx = 0.5, my = 0.32, tx = 0.5, ty = 0.32;

      hero.addEventListener('pointermove', (e) => {
        const r = hero!.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        tx = x / r.width;
        ty = y / r.height;

        const now = performance.now();
        const dt = Math.max(now - lastT, 1);
        const dist = Math.hypot(x - lastX, y - lastY);
        const speed = dist / dt; // px per ms

        // begin a fresh stroke after a long pause or a jump
        if (!stroke || dt > 600 || dist > 160) {
          stroke = [];
          strokes.push(stroke);
          easedW = MIN_W * 1.6;
        }

        // pressure from speed: linger and the ink swells, flick and it tapers
        const targetW = Math.max(MIN_W, Math.min(MAX_W, MAX_W - speed * 16));
        easedW += (targetW - easedW) * 0.25;

        stroke.push({ x, y, w: easedW, t: now });
        if (stroke.length > 260) stroke.shift();

        lastX = x; lastY = y; lastT = now;
      }, { passive: true });

      hero.addEventListener('pointerleave', () => { stroke = null; }, { passive: true });

      // one calligraphic ribbon: varying-width segments, wet-shine core
      function drawStroke(s: Stroke, now: number) {
        // a lone touch still leaves a drop of ink
        if (s.length === 1) {
          const p = s[0];
          const age = now - p.t;
          if (age <= INK_LIFE) {
            const fade = 1 - age / INK_LIFE;
            ctx.fillStyle = `rgba(158, 91, 102, ${0.32 * fade})`;
            ctx.beginPath();
            ctx.arc(p.x, p.y, Math.max(p.w * 0.6, 1.6), 0, Math.PI * 2);
            ctx.fill();
          }
          return;
        }
        for (let i = 1; i < s.length; i++) {
          const a = s[i - 1], b = s[i];
          const age = now - b.t;
          if (age > INK_LIFE) continue;
          const fade = 1 - age / INK_LIFE;
          const alpha = 0.42 * fade;
          const w = b.w * (0.55 + 0.45 * fade);
          const midX = (a.x + b.x) / 2, midY = (a.y + b.y) / 2;

          // rose-gold ink body
          ctx.strokeStyle = `rgba(158, 91, 102, ${alpha})`;
          ctx.lineWidth = w;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.quadraticCurveTo(a.x, a.y, midX, midY);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();

          // wet-ink shine down the centre
          if (w > 3) {
            ctx.strokeStyle = `rgba(255, 249, 244, ${alpha * 0.8})`;
            ctx.lineWidth = Math.max(w * 0.28, 0.8);
            ctx.beginPath();
            ctx.moveTo(a.x, a.y - w * 0.16);
            ctx.lineTo(b.x, b.y - w * 0.16);
            ctx.stroke();
          }
        }
      }

      let running = true;

      function frame(now: number) {
        mx += (tx - mx) * 0.06;
        my += (ty - my) * 0.06;
        hero!.style.setProperty('--mx', (mx * 100).toFixed(2) + '%');
        hero!.style.setProperty('--my', (my * 100).toFixed(2) + '%');

        ctx.clearRect(0, 0, W, H);

        for (let i = strokes.length - 1; i >= 0; i--) {
          const s = strokes[i];
          if (!s.length || now - s[s.length - 1].t > INK_LIFE) {
            if (s !== stroke) strokes.splice(i, 1);
            continue;
          }
          drawStroke(s, now);
        }

        if (running) requestAnimationFrame(frame);
      }

      // pause when the hero is off-screen — no wasted frames
      new IntersectionObserver((entries) => {
        const visible = entries[0].isIntersecting;
        if (visible && !running) {
          running = true;
          requestAnimationFrame(frame);
        } else if (!visible) {
          running = false;
        }
      }).observe(hero);

      requestAnimationFrame(frame);
    }

    // —— HERO GALLERY CYCLE: every 10s the art fades out, a new piece fades in
    {
      const art = document.querySelector<HTMLImageElement>('.hero-art');
      const glow = document.querySelector<HTMLImageElement>('.hero-glow-img');
      const dataEl = document.getElementById('gallery-data');
      const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (art && glow && dataEl && !noMotion) {
        const byFolder: Record<string, string[]> = JSON.parse(dataEl.textContent || '{}');
        const pieces = Object.values(byFolder).flat();

        // shuffle so each visit tours the collection in a different order
        for (let i = pieces.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [pieces[i], pieces[j]] = [pieces[j], pieces[i]];
        }

        let idx = -1;
        let heroVisible = true;
        new IntersectionObserver((entries) => {
          heroVisible = entries[0].isIntersecting;
        }).observe(art);

        const FADE_MS = 900;

        function advance() {
          if (!heroVisible || document.hidden || !pieces.length) return;
          idx = (idx + 1) % pieces.length;
          const next = pieces[idx];

          const pre = new Image();
          pre.onload = () => {
            art!.style.opacity = '0';
            glow!.style.opacity = '0';
            setTimeout(() => {
              art!.onload = () => {
                art!.style.opacity = '1';
                glow!.src = next;
                glow!.style.opacity = '0.55';
              };
              art!.src = next;
              art!.removeAttribute('srcset');
              glow!.removeAttribute('srcset');
            }, FADE_MS);
          };
          pre.src = next;
        }

        setInterval(advance, 10000);
      }
    }
  </script>

  <!-- Shopify Buy-Button embeds -->
  {SHOP_ENABLED && <script is:inline>
    (function () {
      var scriptURL = 'https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js';
      var products = [
        { id: '15619391193462', node: 'product-component-1771500370858' },
        { id: '15619422617974', node: 'product-component-1771500230986' },
        { id: '15619426550134', node: 'product-component-1771500327973' },
        { id: '15619424158070', node: 'product-component-1771500303747' }
      ];
      if (window.ShopifyBuy) {
        if (window.ShopifyBuy.UI) { ShopifyBuyInit(); } else { loadScript(); }
      } else { loadScript(); }
      function loadScript() {
        var s = document.createElement('script');
        s.async = true;
        s.src = scriptURL;
        (document.head || document.body).appendChild(s);
        s.onload = ShopifyBuyInit;
      }
      function ShopifyBuyInit() {
        var client = ShopifyBuy.buildClient({
          domain: 'wr18gc-jx.myshopify.com',
          storefrontAccessToken: 'e4fcf237310b8885d740dfad2d7c649a'
        });
        ShopifyBuy.UI.onReady(client).then(function (ui) {
          products.forEach(function (p) {
            ui.createComponent('product', {
              id: p.id,
              node: document.getElementById(p.node),
              moneyFormat: '%C2%A3%7B%7Bamount%7D%7D',
              options: {}
            });
          });
        });
      }
    })();
  </script>}
</Base>
