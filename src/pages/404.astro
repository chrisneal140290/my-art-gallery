---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found – Motha Maker"
  description="That page could not be found. Return to the Motha Maker gallery."
>
  <section class="about-section">
    <div class="container" style="text-align: center;">
      <h1 style="font-family: var(--serif); font-weight: 300; font-size: clamp(38px, 5vw, 56px); margin-bottom: 14px;">Page not found</h1>
      <div class="heading-rule"></div>
      <p style="color: var(--mid); font-size: 14px; margin-bottom: 36px;">The page you were looking for isn't here.</p>
      <a href="/" class="social-link">Return to the gallery</a>
    </div>
  </section>
</Base>
