---
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.png';
import sunflower from '../assets/sunflower.jpg';
import { SHOP_ENABLED } from '../config';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const defaultOg = await getImage({ src: sunflower, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 82 });
const ogImageUrl = new URL(ogImage ?? defaultOg.src, Astro.site).href;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Motha Maker" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body>
  <!-- Header / Navigation -->
  <header class="header">
    <div class="logo">
      <a href="/">
        <Image src={logo} alt="Motha Maker Logo" class="logo-img" height={128} densities={[1, 2]} loading="eager" />
      </a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav-menu" id="navMenu">
      <a href="/#gallery" class="nav-link">Gallery</a>
      <a href="/#videos" class="nav-link">Videos</a>
      {SHOP_ENABLED && <a href="/#shop" class="nav-link">Shop</a>}
      <a href="/about" class="nav-link">About</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <p class="copyright">&copy; 2026 All artwork and content &copy; Marie Neal</p>
      <div class="social-links">
        <a href="https://www.instagram.com/mothaandmaker" target="_blank" rel="noopener" class="social-link" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          <span>Instagram</span>
        </a>
        <a href="https://www.youtube.com/@mariewatson3371" target="_blank" rel="noopener" class="social-link" aria-label="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/>
          </svg>
          <span>YouTube</span>
        </a>
        <a href="https://www.facebook.com/people/Motha-Maker/61579338660267" target="_blank" rel="noopener" class="social-link" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
          <span>Facebook</span>
        </a>
      </div>
    </div>
  </footer>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose" aria-label="Close">&times;</button>
    <button class="lightbox-prev" id="lightboxPrev" aria-label="Previous">&lsaquo;</button>
    <button class="lightbox-next" id="lightboxNext" aria-label="Next">&rsaquo;</button>
    <div class="lightbox-content">
      <img id="lightboxImage" alt="" />
      <div class="lightbox-video" id="lightboxVideo">
        <iframe
          id="lightboxIframe"
          title="Video player"
          frameborder="0"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <div class="lightbox-actions" id="lightboxActions">
        <button class="wall-btn" id="wallBtn" type="button">What would it look like on my wall?</button>
      </div>
    </div>
  </div>

  <!-- Wall preview overlay -->
  <div class="wall-preview" id="wallPreview">
    <video id="wallCamera" autoplay playsinline muted webkit-playsinline></video>
    <img id="wallStill" class="wall-still" alt="" hidden />
    <div class="wall-stage" id="wallStage">
      <div class="piece finish-framed" id="wallPiece">
        <div class="piece-shadow"></div>
        <div class="wrap3d">
          <div class="edge edge-t"></div>
          <div class="edge edge-r"></div>
          <div class="edge edge-b"></div>
          <div class="edge edge-l"></div>
          <div class="front">
            <div class="frame" id="frameBox">
              <div class="frame-lip">
                <div class="mat" id="matBox">
                  <div class="print">
                    <img id="wallArt" alt="Artwork on your wall" draggable="false" />
                    <div class="glass"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="wall-readout" id="wallReadout">
      <p class="wall-dims" id="wallDims">16 × 16 in</p>
      <p class="wall-sub" id="wallSub">Including frame</p>
    </div>
    <p class="wall-status" id="wallStatus" hidden></p>
    <div class="wall-fallback" id="wallFallback" hidden>
      <p id="wallFallbackText">The live camera isn’t available in this browser.</p>
      <label class="wall-file">
        Take a photo of your wall
        <input id="wallFile" type="file" accept="image/*" capture="environment" />
      </label>
      <button type="button" id="wallRetry">Try the camera again</button>
    </div>
    <button class="wall-flip" id="wallFlip" type="button">Flip camera</button>
    <button class="wall-close" id="wallClose" type="button" aria-label="Close">&times;</button>
    <div class="wall-controls">
      <div class="wall-control-group">
        <span class="wall-label">Long side</span>
        <div class="wall-options" data-group="size">
          <button type="button" data-value="8">8″</button>
          <button type="button" data-value="12" class="active">12″</button>
          <button type="button" data-value="16">16″</button>
          <button type="button" data-value="24">24″</button>
        </div>
      </div>
      <div class="wall-control-group">
        <span class="wall-label">Finish</span>
        <div class="wall-options" data-group="finish">
          <button type="button" data-value="framed" class="active">Framed</button>
          <button type="button" data-value="canvas">Canvas</button>
        </div>
      </div>
    </div>
    <p class="wall-hint">Drag to place. Pinch if you are closer or further than about four feet.</p>
  </div>

  <script>
    // —— HAMBURGER MENU ————————————————————————————————————————————
    const hamburger = document.getElementById('hamburger');
    const navMenu = document.getElementById('navMenu');
    hamburger?.addEventListener('click', () => {
      hamburger.classList.toggle('active');
      navMenu?.classList.toggle('active');
    });
    document.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        hamburger?.classList.remove('active');
        navMenu?.classList.remove('active');
      });
    });

    // —— SHRINKING FROSTED HEADER ——————————————————————————————————
    const header = document.querySelector('.header');
    window.addEventListener(
      'scroll',
      () => header?.classList.toggle('scrolled', window.scrollY > 60),
      { passive: true }
    );

    // —— SMOOTH SCROLL for same-page anchors ———————————————————————
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"], a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const hash = anchor.hash;
        if (!hash) return;
        const onHome = location.pathname === '/' || location.pathname === '/index.html';
        const targetsHome = anchor.getAttribute('href')!.startsWith('#') || onHome;
        if (!targetsHome) return;
        const target = document.querySelector(hash);
        if (target) {
          e.preventDefault();
          window.scrollTo({ top: (target as HTMLElement).offsetTop - 80, behavior: 'smooth' });
        }
      });
    });

    // —— REVEAL ON SCROLL ——————————————————————————————————————————
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // —— LIGHTBOX ——————————————————————————————————————————————————
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImage') as HTMLImageElement | null;
    const lightboxVideo = document.getElementById('lightboxVideo');
    const lightboxIframe = document.getElementById('lightboxIframe') as HTMLIFrameElement | null;
    const lightboxActions = document.getElementById('lightboxActions');

    let lbMode: 'image' | 'video' = 'image';
    let currentList: string[] = [];
    let currentIndex = 0;
    let videoIds: string[] = [];

    const galleryDataEl = document.getElementById('gallery-data');
    const galleryImages: Record<string, string[]> = galleryDataEl
      ? JSON.parse(galleryDataEl.textContent || '{}')
      : {};

    function showLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('visible');
      lightbox.classList.add('active');
      setTimeout(() => lightbox.classList.add('visible'), 20);
      document.body.style.overflow = 'hidden';
    }

    function openImageAt(index: number) {
      if (!lightbox || !lightboxImg || currentList.length === 0) return;
      currentIndex = ((index % currentList.length) + currentList.length) % currentList.length;
      lightboxImg.src = currentList[currentIndex];
      lightboxImg.style.display = 'block';
      lightboxVideo?.classList.remove('active');
      if (lightboxIframe) lightboxIframe.src = '';
      if (lightboxActions) lightboxActions.style.display = 'flex';
      showLightbox();
    }

    function stepImage(direction: number) {
      if (!lightboxImg || currentList.length === 0) return;
      const next = ((currentIndex + direction) % currentList.length + currentList.length) % currentList.length;
      currentIndex = next;
      lightboxImg.style.opacity = '0';
      setTimeout(() => {
        lightboxImg!.src = currentList[next];
        lightboxImg!.onload = () => { lightboxImg!.style.opacity = '1'; };
      }, 260);
    }

    document.addEventListener('click', (e) => {
      const category = (e.target as HTMLElement).closest('.gallery-category');
      if (category) {
        const folder = category.getAttribute('data-folder');
        if (!folder) return;
        lbMode = 'image';
        currentList = galleryImages[folder] || [];
        if (lightboxImg) lightboxImg.style.display = 'block';
        lightboxVideo?.classList.remove('active');
        if (lightboxIframe) lightboxIframe.src = '';
        openImageAt(0);
      }
    });

    // —— VIDEOS ————————————————————————————————————————————————————
    const videoItems = document.querySelectorAll<HTMLElement>('.video-list-item');
    videoIds = Array.from(videoItems).map((el) => el.dataset.videoId || '');
    videoItems.forEach((el, i) => el.addEventListener('click', () => openVideoAt(i)));

    function openVideoAt(index: number) {
      lbMode = 'video';
      currentIndex = index;
      if (lightboxImg) {
        lightboxImg.style.display = 'none';
        lightboxImg.src = '';
      }
      lightboxVideo?.classList.add('active');
      if (lightboxIframe) {
        lightboxIframe.src = `https://www.youtube.com/embed/${videoIds[index]}?autoplay=1&mute=1&playsinline=1`;
      }
      if (lightboxActions) lightboxActions.style.display = 'none';
      showLightbox();
    }

    function stepVideo(direction: number) {
      const total = videoIds.length;
      if (!total) return;
      const next = ((currentIndex + direction) % total + total) % total;
      if (lightboxIframe) lightboxIframe.src = '';
      setTimeout(() => openVideoAt(next), 50);
    }

    function step(direction: number) {
      if (lbMode === 'image') stepImage(direction);
      else stepVideo(direction);
    }

    function closeLightbox() {
      if (!lightbox?.classList.contains('active')) return;
      lightbox.classList.remove('visible');
      setTimeout(() => {
        lightbox.classList.remove('active');
        if (lightboxIframe) lightboxIframe.src = '';
        if (lightboxImg) {
          lightboxImg.src = '';
          lightboxImg.style.display = 'block';
          lightboxImg.style.opacity = '1';
        }
        lightboxVideo?.classList.remove('active');
        document.body.style.overflow = 'auto';
      }, 320);
    }

    document.getElementById('lightboxClose')?.addEventListener('click', closeLightbox);
    document.getElementById('lightboxPrev')?.addEventListener('click', () => step(-1));
    document.getElementById('lightboxNext')?.addEventListener('click', () => step(1));
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });

    let touchStartX = 0, touchStartY = 0, touchStartTime = 0, swipeLocked = false;
    lightbox?.addEventListener('touchstart', (e) => {
      if (!lightbox.classList.contains('active')) return;
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
      touchStartTime = Date.now();
    }, { passive: true });

    lightbox?.addEventListener('touchend', (e) => {
      if (!lightbox.classList.contains('active') || swipeLocked) return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      const velocity = Math.abs(dx) / (Date.now() - touchStartTime);
      if (Math.abs(dy) > Math.abs(dx) * 0.8) return;
      if (Math.abs(dx) < 60 && velocity < 0.4) return;
      swipeLocked = true;
      setTimeout(() => { swipeLocked = false; }, 400);
      step(dx < 0 ? 1 : -1);
    }, { passive: true });

    let wheelLocked = false;
    lightbox?.addEventListener('wheel', (e) => {
      if (!lightbox.classList.contains('active')) return;
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY) * 1.5 && Math.abs(e.deltaX) > 15) {
        e.preventDefault();
        if (wheelLocked) return;
        wheelLocked = true;
        setTimeout(() => { wheelLocked = false; }, 300);
        step(e.deltaX > 0 ? 1 : -1);
      }
    }, { passive: false });

    // —— WALL PREVIEW ——————————————————————————————————————————————
    const wallPreview = document.getElementById('wallPreview');
    const wallCamera = document.getElementById('wallCamera') as HTMLVideoElement | null;
    const wallStill = document.getElementById('wallStill') as HTMLImageElement | null;
    const wallArt = document.getElementById('wallArt') as HTMLImageElement | null;
    const wallPiece = document.getElementById('wallPiece');
    const wallStage = document.getElementById('wallStage');
    const wallBtn = document.getElementById('wallBtn');
    const wallClose = document.getElementById('wallClose');
    const wallFlip = document.getElementById('wallFlip');
    const wallRetry = document.getElementById('wallRetry');
    const wallFile = document.getElementById('wallFile') as HTMLInputElement | null;
    const wallFallback = document.getElementById('wallFallback');
    const wallFallbackText = document.getElementById('wallFallbackText');
    const wallStatus = document.getElementById('wallStatus');
    const wallDims = document.getElementById('wallDims');
    const wallSub = document.getElementById('wallSub');
    const frameBox = document.getElementById('frameBox') as HTMLElement | null;
    const matBox = document.getElementById('matBox') as HTMLElement | null;

    let cameraStream: MediaStream | null = null;
    let facing: 'environment' | 'user' = 'environment';
    let longSide = 12;
    let currentFinish: 'framed' | 'canvas' = 'framed';
    let artW = 1;
    let artH = 1;
    let userScale = 1;
    let ox = 0;
    let oy = 0;
    let openingCamera = false;

    function fmtIn(n: number) {
      const r = Math.round(n * 10) / 10;
      return Number.isInteger(r) ? String(r) : r.toFixed(1);
    }

    function printInches() {
      const aspect = artW / Math.max(artH, 1);
      if (aspect > 0.97 && aspect < 1.03) return { w: longSide, h: longSide };
      if (aspect >= 1) return { w: longSide, h: longSide / aspect };
      return { w: longSide * aspect, h: longSide };
    }

    function frameExtras(printLong: number) {
      if (currentFinish === 'canvas') return { mould: 0, mat: 0, depth: 1.5 };
      if (printLong <= 12) return { mould: 0.75, mat: 1.5, depth: 0 };
      if (printLong <= 16) return { mould: 1, mat: 2, depth: 0 };
      return { mould: 1.25, mat: 2.5, depth: 0 };
    }

    function pixelsPerInch() {
      // Rear-phone vertical field of view is about 60°.
      // At four feet, that shows roughly 55 inches of wall.
      const visibleInches = 55;
      return (window.innerHeight / visibleInches) * userScale;
    }

    function layoutPiece() {
      if (!wallPiece || !wallArt || !frameBox || !matBox) return;
      const print = printInches();
      const extra = frameExtras(Math.max(print.w, print.h));
      const ppi = pixelsPerInch();
      const printPx = print.w * ppi;

      wallArt.style.width = `${printPx}px`;
      frameBox.style.padding = `${extra.mould * ppi}px`;
      matBox.style.padding = `${extra.mat * ppi}px`;
      wallPiece.style.setProperty('--depth', `${Math.max(10, extra.depth * ppi)}px`);
      wallPiece.className = 'piece finish-' + currentFinish;
      wallPiece.style.transform = `translate(calc(-50% + ${ox}px), calc(-50% + ${oy}px))`;

      const src = wallArt.src;
      wallPiece.querySelectorAll<HTMLElement>('.edge').forEach((edge) => {
        edge.style.backgroundImage = src ? `url("${src}")` : '';
      });

      const outerW = print.w + (extra.mould + extra.mat) * 2;
      const outerH = print.h + (extra.mould + extra.mat) * 2;
      if (wallDims) {
        wallDims.textContent = `${fmtIn(outerW)} × ${fmtIn(outerH)} in`;
      }
      if (wallSub) {
        if (currentFinish === 'canvas') {
          wallSub.textContent = `Canvas ${fmtIn(print.w)} × ${fmtIn(print.h)} in, 1.5 in deep`;
        } else {
          wallSub.textContent = `Print ${fmtIn(print.w)} × ${fmtIn(print.h)} in, with mount and frame`;
        }
      }
    }

    function setStatus(message: string) {
      if (!wallStatus) return;
      wallStatus.hidden = !message;
      wallStatus.textContent = message;
    }

    function showFallback(message: string) {
      if (wallFallbackText) wallFallbackText.textContent = message;
      wallFallback?.removeAttribute('hidden');
      if (wallCamera) wallCamera.style.visibility = 'hidden';
    }

    function hideFallback() {
      wallFallback?.setAttribute('hidden', '');
      if (wallCamera) wallCamera.style.visibility = '';
    }

    function stopCamera() {
      cameraStream?.getTracks().forEach((track) => track.stop());
      cameraStream = null;
      if (wallCamera) wallCamera.srcObject = null;
    }

    function inAppBrowser() {
      return /FBAN|FBAV|Instagram|TikTok|Snapchat|Line\//i.test(navigator.userAgent || '');
    }

    async function attachStream(stream: MediaStream) {
      if (!wallCamera) return;
      stopCamera();
      cameraStream = stream;
      wallCamera.muted = true;
      wallCamera.defaultMuted = true;
      wallCamera.playsInline = true;
      wallCamera.setAttribute('playsinline', '');
      wallCamera.setAttribute('webkit-playsinline', 'true');
      wallCamera.srcObject = stream;
      wallCamera.style.transform = facing === 'user' ? 'scaleX(-1)' : '';
      wallStill?.setAttribute('hidden', '');
      try {
        await wallCamera.play();
      } catch {
        // Some browsers start playback once the element is visible.
      }
      hideFallback();
      setStatus('');
    }

    async function startCamera() {
      if (openingCamera) return;
      openingCamera = true;
      setStatus('Asking for the camera…');

      if (!window.isSecureContext) {
        setStatus('');
        showFallback('The camera only works on the secure https site. Open mothamaker.com directly.');
        openingCamera = false;
        return;
      }
      if (!navigator.mediaDevices?.getUserMedia) {
        setStatus('');
        showFallback(inAppBrowser()
          ? 'This in-app browser blocks the camera. Open the page in Safari or Chrome, or take a photo of the wall.'
          : 'This browser can’t open a live camera. Take a photo of the wall instead.');
        openingCamera = false;
        return;
      }

      const policy = document.permissionsPolicy || (document as Document & { featurePolicy?: { allowsFeature: (name: string) => boolean } }).featurePolicy;
      if (policy && policy.allowsFeature('camera') === false) {
        setStatus('');
        showFallback('Cloudflare is blocking the camera on this site, so the browser will not ask for permission. In Cloudflare, change the Permissions-Policy header to camera=(self). Until then, take a photo of the wall below.');
        openingCamera = false;
        return;
      }

      const gum = (constraints: MediaStreamConstraints) => navigator.mediaDevices.getUserMedia(constraints);

      let stream: MediaStream;
      try {
        // The plain request is what actually raises the permission prompt on iPhone and Android.
        stream = await gum({ audio: false, video: true });
      } catch (error) {
        setStatus('');
        const name = error instanceof DOMException ? error.name : '';
        if (name === 'NotAllowedError' || name === 'PermissionDeniedError') {
          showFallback('Camera permission was blocked. Allow the camera for this site in your browser settings, or take a photo of the wall.');
        } else if (name === 'NotFoundError' || name === 'DevicesNotFoundError') {
          showFallback('No camera was found on this device. Take a photo of the wall instead.');
        } else if (inAppBrowser()) {
          showFallback('Open this page in Safari or Chrome to use the live camera, or take a photo of the wall.');
        } else {
          showFallback('The camera didn’t start. Take a photo of the wall, or try again.');
        }
        openingCamera = false;
        return;
      }

      const seen = stream.getVideoTracks()[0]?.getSettings?.().facingMode;
      if (seen && seen !== facing) {
        stream.getTracks().forEach((track) => track.stop());
        try {
          stream = await gum({ audio: false, video: { facingMode: { ideal: facing } } });
        } catch {
          try {
            stream = await gum({ audio: false, video: true });
          } catch {
            setStatus('');
            showFallback('The camera closed before it could start. Try again, or take a photo of the wall.');
            openingCamera = false;
            return;
          }
        }
      }

      const mode = stream.getVideoTracks()[0]?.getSettings?.().facingMode;
      if (mode === 'user' || mode === 'environment') facing = mode;
      await attachStream(stream);
      openingCamera = false;
    }

    function openWallPreview() {
      if (!lightboxImg?.src || !wallPreview || !wallArt) return;
      ox = 0;
      oy = 0;
      userScale = 1;
      wallArt.src = lightboxImg.src;
      wallPreview.classList.add('active');
      hideFallback();
      layoutPiece();
      // Invoke getUserMedia inside the tap, before any await.
      void startCamera();
    }

    function closeWallPreview() {
      wallPreview?.classList.remove('active');
      stopCamera();
      setStatus('');
      hideFallback();
    }

    wallArt?.addEventListener('load', () => {
      artW = wallArt.naturalWidth || 1;
      artH = wallArt.naturalHeight || 1;
      layoutPiece();
    });

    wallBtn?.addEventListener('click', (event) => {
      event.stopPropagation();
      openWallPreview();
    });
    wallClose?.addEventListener('click', closeWallPreview);
    wallRetry?.addEventListener('click', () => {
      hideFallback();
      void startCamera();
    });
    wallFlip?.addEventListener('click', () => {
      facing = facing === 'environment' ? 'user' : 'environment';
      void startCamera();
    });

    wallFile?.addEventListener('change', () => {
      const file = wallFile.files?.[0];
      if (!file || !wallStill) return;
      wallStill.src = URL.createObjectURL(file);
      wallStill.hidden = false;
      stopCamera();
      if (wallCamera) wallCamera.style.visibility = 'hidden';
      hideFallback();
      setStatus('');
    });

    document.querySelectorAll('.wall-options').forEach((group) => {
      group.querySelectorAll('button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const g = (group as HTMLElement).dataset.group;
          group.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          if (g === 'size') longSide = Number(btn.dataset.value) || 12;
          if (g === 'finish') currentFinish = (btn.dataset.value as 'framed' | 'canvas') || 'framed';
          layoutPiece();
        });
      });
    });

    let drag: { x: number; y: number; ox: number; oy: number } | null = null;
    wallPiece?.addEventListener('pointerdown', (event) => {
      if (!wallPiece) return;
      if ((event.target as HTMLElement).closest('button')) return;
      wallPiece.setPointerCapture(event.pointerId);
      drag = { x: event.clientX, y: event.clientY, ox, oy };
    });
    wallPiece?.addEventListener('pointermove', (event) => {
      if (!drag) return;
      ox = drag.ox + (event.clientX - drag.x);
      oy = drag.oy + (event.clientY - drag.y);
      layoutPiece();
    });
    wallPiece?.addEventListener('pointerup', () => { drag = null; });
    wallPiece?.addEventListener('pointercancel', () => { drag = null; });

    function touchDistance(touches: TouchList) {
      const dx = touches[0].clientX - touches[1].clientX;
      const dy = touches[0].clientY - touches[1].clientY;
      return Math.hypot(dx, dy);
    }
    let pinch: { dist: number; scale: number } | null = null;
    wallStage?.addEventListener('touchstart', (event) => {
      if (event.touches.length === 2) {
        pinch = { dist: touchDistance(event.touches), scale: userScale };
      }
    }, { passive: true });
    wallStage?.addEventListener('touchmove', (event) => {
      if (event.touches.length === 2 && pinch) {
        event.preventDefault();
        const next = pinch.scale * (touchDistance(event.touches) / pinch.dist);
        userScale = Math.min(2.6, Math.max(0.45, next));
        layoutPiece();
      }
    }, { passive: false });
    wallStage?.addEventListener('touchend', () => { pinch = null; });
    window.addEventListener('resize', () => {
      if (wallPreview?.classList.contains('active')) layoutPiece();
    });
  </script>

